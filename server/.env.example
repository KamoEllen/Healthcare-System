# ========== ENVIRONMENT ==========
NODE_ENV=development
PORT=3000

# ========== DATABASE ==========
# Local: postgresql://postgres:password@localhost:5432/healthcare_db
# Render (Production): Get from Render dashboard after creating PostgreSQL service
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# ========== JWT CONFIGURATION ==========
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters
JWT_SECRET=your_min_32_character_secret_here_change_me_for_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ========== EMAIL CONFIGURATION ==========
# Options: mailtrap (free) | resend (free) | ses (paid)
EMAIL_PROVIDER=mailtrap

# Mailtrap Setup (Free tier: 2000 emails/month)
# 1. Go to https://mailtrap.io
# 2. Sign up with email
# 3. Get credentials from API Tokens section
EMAIL_USER=your_mailtrap_username
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM=noreply@healthcare.dev

# Resend Alternative (EMAIL_PROVIDER=resend)
# EMAIL_USER=resend
# EMAIL_PASS=re_your_resend_api_key

# AWS SES Alternative (EMAIL_PROVIDER=ses)
# EMAIL_USER=AKIAIOSFODNN7EXAMPLE
# EMAIL_PASS=your_ses_smtp_password
# AWS_REGION=us-east-1

# ========== CORS CONFIGURATION ==========
# Local development: http://localhost:4200
# Production Netlify: https://your-site.netlify.app
# Production Vercel: https://your-site.vercel.app
CORS_ORIGIN=http://localhost:4200

# ========== RATE LIMITING ==========
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100
